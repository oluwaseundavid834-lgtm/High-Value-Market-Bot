# Telegram
TELEGRAM_BOT_TOKEN=123456789:AA-your-telegram-bot-token
ADMIN_ID=123456789

# AI Provider (OpenAI-compatible)
AI_API_KEY=sk-your-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60

# Database (SQLite path)
DATABASE_PATH=data/bot.db

# Webhook (leave blank to use polling in dev; Railway auto-detects RAILWAY_PUBLIC_DOMAIN)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook

# Server
PORT=8000

# Usage limits
FREE_DAILY_LIMIT=15
PREMIUM_DAILY_LIMIT=300
FREE_AUDIT_LIMIT=2
PREMIUM_AUDIT_LIMIT=50
